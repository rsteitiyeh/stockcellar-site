---
import { getCollection } from 'astro:content';
import site from '../../../site.config.json';
import Base from '../../layouts/Base.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => +b.data.publishDate - +a.data.publishDate);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const t = site.theme;
---
<Base title={`Every Free Guide and Article Published by ${site.BRAND}`} description={`Every free guide published on ${site.BRAND}, covering real numbers, real costs, and plain-English answers instead of padded search filler.`}>
  <header class="nav">
    <a class="brand" href="/"><span class="brand-word">{site.BRAND}</span></a>
    <nav aria-label="Main navigation">
      <a href="/guides/">Guides</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
    </nav>
    <a class="btn sm" href="/#tool">{site.comingSoon?.captureLabel || 'Free tool'}</a>
  </header>
  <main class="guides">
    <h1>Guides</h1>
    <ul>
      {articles.map((a) => (
        <li>
          <a href={`/${a.id}/`}>{a.data.title}</a>
          <p>{a.data.description}</p>
          <small>{fmt(a.data.updatedDate ?? a.data.publishDate)}</small>
        </li>
      ))}
    </ul>
    {articles.length === 0 && <p>Guides are coming soon.</p>}
  </main>
  <a href="https://hop.clickbank.net/?affiliate=soloaiclub&vendor=lostrec&tid=stockcellar" rel="sponsored nofollow noopener" target="_blank" class="ad ad-filled" style="display:flex;flex-direction:column;align-items:center;gap:4px;width:min(970px,calc(100% - 32px));margin:27px auto;text-decoration:none"><span style="font:700 9px ui-monospace,monospace;letter-spacing:1.6px;text-transform:uppercase;opacity:.55;color:inherit">Sponsored</span><img src="/images/cb-lostrec-728x90.png" width="728" height="90" alt="Sponsored offer" loading="lazy" style="max-width:100%;height:auto;border-radius:6px;box-shadow:0 2px 10px rgba(0,0,0,.12)"></a>
  <footer>
    <a class="brand" href="/"><span class="brand-word sm">{site.BRAND}</span></a>
    <nav><a href="/guides/">Guides</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/disclosure/">Disclosure</a><a href="/editorial/">Editorial</a></nav>
    <p>Some links on this site are <a href="/disclosure/">affiliate links</a>. If you click through and make a purchase, we may earn a commission at no additional cost to you. This helps keep our guides free.</p>
    <small>&copy; 2026 {site.BRAND}. Educational information only, not professional advice.</small>
  </footer>
</Base>

<style define:vars={{ bg: t.bg, ink: t.ink, accent: t.accent, headingFont: t.headingFont, bodyFont: t.bodyFont }} is:global>
  .nav{position:sticky;top:0;z-index:50;background:var(--bg);border-bottom:1px solid rgba(0,0,0,.12);display:flex;align-items:center;gap:clamp(14px,3vw,32px);flex-wrap:wrap;padding:12px clamp(16px,4vw,40px);font-family:var(--bodyFont)}
  .brand{display:flex;align-items:center;gap:9px;color:var(--ink);text-decoration:none}
  .brand-word{font-family:var(--headingFont);font-weight:700;font-size:20px;color:var(--ink)}
  .brand-word.sm{font-size:16px}
  .nav nav{display:flex;gap:clamp(12px,2.5vw,26px);flex-wrap:wrap;margin-left:auto}
  .nav nav a{font-size:14.5px;color:var(--ink);text-decoration:none;opacity:.8}
  .nav nav a:hover{opacity:1;text-decoration:underline}
  .btn{display:inline-flex;justify-content:center;align-items:center;font-weight:700;background:var(--accent);color:#fff;border:none;cursor:pointer;padding:13px 22px;border-radius:8px;font-size:15px;text-decoration:none}
  .btn.sm{padding:8px 14px;font-size:13px}
  .guides { max-width: 760px; margin: 0 auto; padding: 40px 20px 80px; background: var(--bg); color: var(--ink); font-family: var(--bodyFont); }
  .guides h1 { font-family: var(--headingFont); }
  .guides ul { list-style: none; padding: 0; }
  .guides li { margin: 24px 0; }
  .guides li a { font-weight: 700; font-size: 20px; color: var(--accent); text-decoration: none; }
  .guides li p { margin: 4px 0; }
  .guides small { opacity: .7; }
  footer{max-width:1120px;margin:0 auto;padding:36px clamp(20px,5vw,32px) 44px;font-family:var(--bodyFont);color:var(--ink)}
  footer .brand{margin-bottom:22px}
  footer nav{display:flex;gap:20px;flex-wrap:wrap;margin-bottom:22px}
  footer nav a{font-size:13.5px;color:var(--ink);opacity:.75;text-decoration:none}
  footer nav a:hover{opacity:1;text-decoration:underline}
  footer p{font-size:13px;opacity:.75;line-height:1.7;margin:0 0 8px}
  footer small{font-size:13px;opacity:.75}
  @media(max-width:850px){.nav nav{display:none}}
</style>
