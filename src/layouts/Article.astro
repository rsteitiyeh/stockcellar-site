---
import Base from './Base.astro';
import site from '../../site.config.json';
import { extractFaq } from '../lib/faq.mjs';
import { organization, breadcrumb, orgId } from '../lib/seo.mjs';
import heroes from '../lib/article-images.json';

interface Props {
  entry: any;        // content collection entry
  related?: { title: string; slug: string; description?: string }[];
}
const { entry, related = [] } = Astro.props;
const { title, description, publishDate, updatedDate, author } = entry.data;
// PIPELINE GUARD 2026-07-27: never ship a page with no meta description.
// A meaningful share of drip-queued articles arrive with no `description:` in
// their frontmatter; the drip would reintroduce the gap on every publish.
// Prefer the written one, fall back to the article's own opening prose rather
// than emitting nothing.
const _rawBody = (entry.body ?? '')
  .replace(/^---[\s\S]*?---/, '')
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/^\s*#{1,6}\s+.*$/gm, ' ')
  .replace(/^\s*[>|*\-+]\s+/gm, ' ')
  .replace(/[*_`#>|]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const _autoDesc = (() => {
  if (!_rawBody) return '';
  let out = '';
  for (const sentence of _rawBody.split(/(?<=[.!?])\s+/)) {
    if ((out + ' ' + sentence).trim().length > 155) break;
    out = (out + ' ' + sentence).trim();
  }
  if (!out) out = _rawBody.slice(0, 152).replace(/\s+\S*$/, '');
  return out;
})();
const metaDescription = (description && description.trim()) ? description.trim() : _autoDesc;
const updated = updatedDate ?? publishDate;
const authorName = author ?? site.author.name;
const canonical = new URL(`/${entry.id}/`, site.SITE).href;
const t = site.theme;

const faqs = extractFaq(entry.body);
const hero = heroes[entry.id] || null;
const graph = [];
graph.push(organization(site));
graph.push(breadcrumb(site, [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides/' },
  { name: title }
]));
graph.push({
  '@type': 'Article',
  headline: title,
  description,
  author: { '@type': 'Organization', name: authorName, url: site.SITE },
  publisher: { '@id': orgId(site) },
  datePublished: publishDate.toISOString().slice(0, 10),
  dateModified: updated.toISOString().slice(0, 10),
  mainEntityOfPage: canonical
});
if (faqs.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a }
    }))
  });
}
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
const fmt = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={title} description={metaDescription} ogType="article" ogImage={hero}>
  <script type="application/ld+json" set:html={jsonld} slot="head" />
  <header class="nav">
    <a class="brand" href="/"><span class="brand-word">{site.BRAND}</span></a>
    <nav aria-label="Main navigation">
      <a href="/guides/">Guides</a>
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
    </nav>
    <a class="btn sm" href="/#tool">{site.comingSoon?.captureLabel || 'Free tool'}</a>
  </header>
  <main class="article-wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> › <a href="/guides/">Guides</a> › <span>{title}</span>
    </nav>
    <article>
      <header class="article-head">
        <h1>{title}</h1>
        <p class="byline">
          By {authorName} · Updated <time datetime={updated.toISOString().slice(0, 10)}>{fmt(updated)}</time>
        </p>
      </header>
      <div class="prose">
        <slot />
      </div>
      <aside class="cta-card">
        <slot name="cta">
          <p><strong>Try the free tool</strong> · no signup needed.</p>
          <a class="btn" href="/#tool">Open the free tool</a>
        </slot>
      </aside>
      <aside class="article-capture">
        <p class="ac-kicker">Free download</p>
        <p class="ac-lead">{site.comingSoon?.captureLabel || 'Get the free guide'}</p>
        <form class="ac-form" method="post" action="/api/subscribe" data-article-capture>
          <label class="sr" for="ac-email">Email address</label>
          <input id="ac-email" name="email" type="email" required autocomplete="email" placeholder="you@email.com" />
          <button type="submit">{site.comingSoon?.captureLabel || 'Send it to me'}</button>
        </form>
        <p class="ac-micro">No spam, no sales calls, unsubscribe anytime.</p>
        <p class="ac-done" hidden>{site.magnet?.doneMessage || 'Check your inbox.'}</p>
      </aside>

      {related.length > 0 && (
        <section class="related">
          <h2>Related guides</h2>
          <ul>
            {related.map(r => (
              <li><a href={`/${r.slug}/`}>{r.title}</a>{r.description && <p>{r.description}</p>}</li>
            ))}
          </ul>
        </section>
      )}

      <aside class="offer-box" style="margin:2rem 0;padding:1.25rem 1.4rem;border-radius:10px;font-size:0.95em;line-height:1.6;background:rgba(0,0,0,0.04);border-left:4px solid currentColor">
        <p style="margin:0"><strong>Recommended for you:</strong> The Lost Superfoods, a book of long-keeping survival foods and the storage methods behind them. <em>Affiliate disclosure: {new URL(site.SITE).hostname} may earn a commission if you purchase through this link, at no extra cost to you.</em></p>
        <p style="margin:0.7rem 0 0 0"><a href="https://hop.clickbank.net/?affiliate=soloaiclub&vendor=lostrec&tid=stockcellar" rel="sponsored nofollow noopener" target="_blank"><strong>Learn more &rarr;</strong></a></p>
        <a href="https://hop.clickbank.net/?affiliate=soloaiclub&vendor=lostrec&tid=stockcellar" rel="sponsored nofollow noopener" target="_blank" class="ad ad-filled" style="display:flex;flex-direction:column;align-items:center;gap:4px;width:min(970px,calc(100% - 32px));margin:27px auto;text-decoration:none"><span style="font:700 9px ui-monospace,monospace;letter-spacing:1.6px;text-transform:uppercase;opacity:.55;color:inherit">Sponsored</span><img src="/images/cb-lostrec-728x90.png" width="728" height="90" alt="Sponsored offer" loading="lazy" style="max-width:100%;height:auto;border-radius:6px;box-shadow:0 2px 10px rgba(0,0,0,.12)"></a>
      </aside>
    </article>
  <script is:inline>
    // Self-contained: does not depend on the homepage Landing script.
    document.querySelectorAll('[data-article-capture]').forEach((f) => {
      f.addEventListener('submit', async (e) => {
        e.preventDefault();
        const box = f.closest('.article-capture');
        const email = f.querySelector('input[name=email]').value.trim();
        if (!email) return;
        const btn = f.querySelector('button');
        btn.disabled = true;
        try {
          const r = await fetch('/api/subscribe', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email })
          });
          const j = await r.json();
          if (j && j.ok) {
            f.hidden = true;
            const done = box.querySelector('.ac-done');
            if (done) done.hidden = false;
            if (window.gtag) window.gtag('event', 'generate_lead', { method: 'article_capture' });
            return;
          }
        } catch (err) {}
        btn.disabled = false;
      });
    });
  </script>
  </main>
  <footer>
    <a class="brand" href="/"><span class="brand-word sm">{site.BRAND}</span></a>
    <nav><a href="/guides/">Guides</a><a href="/about/">About</a><a href="/contact/">Contact</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/disclosure/">Disclosure</a><a href="/editorial/">Editorial</a></nav>
    <p>Some links on this site are <a href="/disclosure/">affiliate links</a>. If you click through and make a purchase, we may earn a commission at no additional cost to you. This helps keep our guides free.</p>
    <small>&copy; 2026 {site.BRAND}. Educational information only, not professional advice.</small>
  </footer>
</Base>

<style define:vars={{ bg: t.bg, ink: t.ink, accent: t.accent, headingFont: t.headingFont, bodyFont: t.bodyFont }} is:global>
  .nav{position:sticky;top:0;z-index:50;background:var(--bg);border-bottom:1px solid rgba(0,0,0,.12);display:flex;align-items:center;gap:clamp(14px,3vw,32px);flex-wrap:wrap;padding:12px clamp(16px,4vw,40px);font-family:var(--bodyFont)}
  .brand{display:flex;align-items:center;gap:9px;color:var(--ink);text-decoration:none}
  .brand-word{font-family:var(--headingFont);font-weight:700;font-size:20px;color:var(--ink)}
  .brand-word.sm{font-size:16px}
  .nav nav{display:flex;gap:clamp(12px,2.5vw,26px);flex-wrap:wrap;margin-left:auto}
  .nav nav a{font-size:14.5px;color:var(--ink);text-decoration:none;opacity:.8}
  .nav nav a:hover{opacity:1;text-decoration:underline}
  .btn{display:inline-flex;justify-content:center;align-items:center;font-weight:700;background:var(--accent);color:#fff;border:none;cursor:pointer;padding:13px 22px;border-radius:8px;font-size:15px;text-decoration:none}
  .btn.sm{padding:8px 14px;font-size:13px}

  html,body{background:var(--bg)}
  .article-wrap { max-width: 760px; margin: 0 auto; padding: 32px 20px 80px; background: var(--bg); color: var(--ink); font-family: var(--bodyFont); }
  .breadcrumb { font-size: 13px; opacity: .75; margin-bottom: 24px; }
  .sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  .article-capture{margin:2.5rem 0;padding:1.4rem 1.5rem;border-radius:10px;background:rgba(0,0,0,.04);border:1px solid rgba(0,0,0,.09)}
  .ac-kicker{margin:0 0 .3rem;font:700 10px/1 ui-monospace,monospace;letter-spacing:.14em;
    text-transform:uppercase;opacity:.6}
  .ac-lead{margin:0 0 .9rem;font-weight:600;font-size:1.05rem}
  .ac-form{display:flex;gap:.5rem;flex-wrap:wrap}
  .ac-form input{flex:1 1 240px;padding:.7rem .9rem;border-radius:7px;border:1px solid rgba(0,0,0,.2);font:inherit;font-size:.95rem;background:#fff;color:inherit}
  .ac-form button{padding:.7rem 1.1rem;border-radius:7px;border:0;cursor:pointer;font:inherit;font-weight:600;font-size:.95rem;background:var(--accent);color:#fff}
  .ac-micro{margin:.6rem 0 0;font-size:.8rem;opacity:.65}
  .ac-done{margin:.6rem 0 0;font-weight:600}
  .article-head h1 { line-height: 1.15; margin: 0 0 8px; font-family: var(--headingFont); }
  .byline { font-size: 14px; opacity: .8; margin: 0 0 32px; }
  .prose h2, .prose h3 { font-family: var(--headingFont); }
  .prose h2 { margin-top: 2.2em; }
  .prose h3 { margin-top: 1.6em; }
  .prose a { color: var(--accent); text-decoration: underline; }
  .prose ul, .prose ol { padding-left: 1.4em; }
  .prose blockquote { margin: 1.4em 0; padding: 12px 18px; border-left: 4px solid var(--accent); background: rgba(0,0,0,0.03); font-style: italic; }
  .prose table { border-collapse: collapse; width: 100%; margin: 1.2em 0; }
  .prose th, .prose td { border: 1px solid #d5d5d5; padding: 8px 10px; text-align: left; }
  .prose table th { background: rgba(0,0,0,0.04); }
  .prose img { max-width: 100%; height: auto; }
  .cta-card { margin: 40px 0; padding: 24px; border: 1px solid #ddd; border-radius: 12px; }
  .cta-card .btn { display: inline-block; padding: 12px 20px; border-radius: 10px; color: #fff; background: var(--accent); font-weight: 700; text-decoration: none; }
  .related ul { list-style: none; padding: 0; }
  .related li { margin: 12px 0; }

  footer{max-width:1120px;margin:0 auto;padding:36px clamp(20px,5vw,32px) 44px;font-family:var(--bodyFont);color:var(--ink)}
  footer .brand{margin-bottom:22px}
  footer nav{display:flex;gap:20px;flex-wrap:wrap;margin-bottom:22px}
  footer nav a{font-size:13.5px;color:var(--ink);opacity:.75;text-decoration:none}
  footer nav a:hover{opacity:1;text-decoration:underline}
  footer p{font-size:13px;opacity:.75;line-height:1.7;margin:0 0 8px}
  footer small{font-size:13px;opacity:.75}

  @media(max-width:850px){.nav nav{display:none}}
</style>
