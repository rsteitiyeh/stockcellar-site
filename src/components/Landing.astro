---
import site from '../../site.config.json';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { organization, website } from '../lib/seo.mjs';
const all = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => +(b.data.updatedDate ?? b.data.publishDate) - +(a.data.updatedDate ?? a.data.publishDate));
const homeGuides = all.slice(0, 30);
const total = all.length;
const colA = homeGuides.filter((_, i) => i % 2 === 0);
const colB = homeGuides.filter((_, i) => i % 2 === 1);
---
<Base title="StockCellar: Food Storage Shelf Life, Methods and Rotation" description="A household reference for food storage: how long staples really last, the packing methods that hold, and the rotation habits that keep a pantry honest.">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [organization(site), website(site)]
  })} />

<div class="sc" style="position:relative;min-height:100vh;background:#f3ecdd;color:#2a2621;font-family:'EB Garamond',Georgia,serif;overflow:hidden">
  <div style="position:absolute;inset:0;pointer-events:none;background-image:repeating-linear-gradient(0deg,rgba(88,68,44,.045) 0 1px,transparent 1px 3px),repeating-linear-gradient(90deg,rgba(88,68,44,.032) 0 1px,transparent 1px 4px),repeating-linear-gradient(24deg,rgba(120,96,60,.028) 0 2px,transparent 2px 9px),radial-gradient(130% 70% at 50% -10%,rgba(255,253,246,.85),rgba(255,253,246,0) 62%),radial-gradient(120% 90% at 50% 110%,rgba(112,88,52,.09),rgba(112,88,52,0) 55%)"></div>

  <div style="position:relative;max-width:1220px;margin:0 auto;padding:0 56px 0" class="sc-wrap">

    <div style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:6px 24px;padding:14px 0 10px;border-bottom:1px solid rgba(42,38,33,.5);font:400 10.5px/1 'EB Garamond',Georgia,serif;letter-spacing:.19em;text-transform:uppercase;color:rgba(42,38,33,.62)">
      <span style="white-space:nowrap">Vol.&nbsp;I &nbsp;·&nbsp; No.&nbsp;1</span>
      <span style="flex:none;letter-spacing:.2em;white-space:nowrap">A Household Reference for the Keeping of Food</span>
      <span style="white-space:nowrap">Revised 7 August 2026</span>
    </div>

    <header style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:20px 40px;padding:38px 0 22px">
      <div style="display:flex;align-items:flex-end;gap:20px">
        <div style="position:relative;width:34px;height:44px;flex:none;margin-bottom:9px">
          <div style="position:absolute;left:4px;right:4px;top:0;height:6px;border:1.2px solid #6f1d1d;border-bottom:none;border-radius:2px 2px 0 0"></div>
          <div style="position:absolute;left:0;right:0;top:6px;bottom:0;border:1.2px solid #6f1d1d;border-radius:3px 3px 6px 6px;background-image:repeating-linear-gradient(90deg,rgba(111,29,29,.28) 0 1px,transparent 1px 4px)"></div>
          <div style="position:absolute;left:1.2px;right:1.2px;top:16px;height:11px;background:#f3ecdd;border-top:1.2px solid #6f1d1d;border-bottom:1.2px solid #6f1d1d"></div>
        </div>
        <div>
          <h1 style="margin:0;font-family:'Bodoni Moda',Didot,'Times New Roman',serif;font-optical-sizing:auto;font-weight:500;font-size:clamp(44px,7vw,74px);line-height:.9;letter-spacing:-.012em;color:#2a2621">StockCellar</h1>
          <div style="margin-top:12px;font:400 13px/1 'EB Garamond',Georgia,serif;letter-spacing:.24em;text-transform:uppercase;color:rgba(42,38,33,.7)">Provisions <span style="font-family:'Bodoni Moda',Didot,serif;font-style:italic;font-size:19px;letter-spacing:0;vertical-align:-2px;color:#6f1d1d">&amp;</span> Their Keeping</div>
        </div>
      </div>
      <nav style="display:flex;flex:none;align-items:baseline;gap:26px;padding-bottom:12px;font:400 11px/1 'EB Garamond',Georgia,serif;letter-spacing:.17em;text-transform:uppercase;flex-wrap:wrap">
        <a href="#ledger" style="color:rgba(42,38,33,.78);white-space:nowrap">The Ledger</a>
        <a href="/guides/" style="color:rgba(42,38,33,.78);white-space:nowrap">Index</a>
        <a href="/about/" style="color:rgba(42,38,33,.78);white-space:nowrap">About</a>
        <a href="/contact/" style="color:rgba(42,38,33,.78);white-space:nowrap">Corrections</a>
      </nav>
    </header>

    <div style="height:3px;border-top:1.6px solid rgba(42,38,33,.72);border-bottom:.5px solid rgba(42,38,33,.72)"></div>

    <section id="ledger" style="padding:34px 0 0;scroll-margin-top:20px">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:32px;margin-bottom:16px;flex-wrap:wrap">
        <h2 style="margin:0;font-family:'Bodoni Moda',Didot,serif;font-weight:500;font-size:34px;line-height:1;letter-spacing:.01em;color:#2a2621">The Shelf-Life Ledger</h2>
        <p style="margin:0 0 5px;font:400 13.5px/1.4 'EB Garamond',Georgia,serif;font-style:italic;color:rgba(42,38,33,.62);text-align:right;max-width:400px">Figures assume unopened storage at 21&nbsp;°C, dark and dry.<br>Warmer rooms halve nearly everything.</p>
      </div>
      <table style="width:100%;border-collapse:collapse;border-top:1.4px solid rgba(42,38,33,.75);border-bottom:1.4px solid rgba(42,38,33,.75)">
        <thead>
          <tr>
            <th class="sc-th">Item</th><th class="sc-th">Method</th><th class="sc-th">Lasts</th><th class="sc-th">Notes</th>
          </tr>
        </thead>
        <tbody>
          <tr><td class="sc-td sc-item">White rice, long-grain</td><td class="sc-td">Mylar, sealed with oxygen absorbers</td><td class="sc-td sc-num">25 years</td><td class="sc-td sc-note">Brown rice will not keep; the bran oil turns rancid inside a year.</td></tr>
          <tr><td class="sc-td sc-item">Pinto beans, dry</td><td class="sc-td">Mylar, sealed with oxygen absorbers</td><td class="sc-td sc-num">25 years</td><td class="sc-td sc-note">Safe throughout, but they harden after year eight. Pressure-cook thereafter.</td></tr>
          <tr><td class="sc-td sc-item">Honey</td><td class="sc-td">Glass, lid sealed, cool and dark</td><td class="sc-td sc-num">Indefinite</td><td class="sc-td sc-note">Crystallises in the cold. Stand the jar in 40&nbsp;°C water to return it.</td></tr>
          <tr><td class="sc-td sc-item">Nonfat dry milk</td><td class="sc-td">Nitrogen-packed No.&nbsp;10 can</td><td class="sc-td sc-num">20 years</td><td class="sc-td sc-note">Instant granules keep roughly half as long as the regular powder.</td></tr>
          <tr><td class="sc-td sc-item">Cooking oil, olive</td><td class="sc-td">Dark bottle, unopened, 15&nbsp;°C</td><td class="sc-td sc-num">2 years</td><td class="sc-td sc-note">The shortest line in the cellar. Buy small, rotate often, keep it dark.</td></tr>
          <tr><td class="sc-td sc-item">Tomatoes, canned</td><td class="sc-td">Commercial tin, on the shelf</td><td class="sc-td sc-num">18 months</td><td class="sc-td sc-note">Acid shortens the tin's life. Discard any can with a dented seam.</td></tr>
        </tbody>
      </table>
      <div style="display:flex;justify-content:space-between;gap:24px;padding:10px 16px 0;font:400 12.5px/1.5 'EB Garamond',Georgia,serif;font-style:italic;color:rgba(42,38,33,.55);flex-wrap:wrap">
        <span>Further entries are recorded in the index below.</span>
        <span>Compiled from extension-service bulletins; revised as they are.</span>
      </div>
    </section>

    <section class="sc-intro" style="display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:56px;align-items:start;padding:44px 0 6px;margin-top:34px;border-top:.6px solid rgba(42,38,33,.28)">
      <p style="margin:0;font:400 19px/1.62 'EB Garamond',Georgia,serif;color:#2a2621;max-width:70ch;text-wrap:pretty">
        <span style="float:left;font-family:'Bodoni Moda',Didot,serif;font-weight:500;font-size:82px;line-height:.76;padding:6px 12px 0 0;color:#6f1d1d">S</span>tockCellar is a reference, not a periodical. There is nothing here to keep up with. Every entry states the food, the method it was stored by, the span it holds, and the one thing most often got wrong about it. Where sources disagree, the shorter figure is printed and the disagreement noted. Where no good figure exists, the entry says so plainly rather than guessing.
      </p>
      <aside style="border-left:.6px solid rgba(42,38,33,.28);padding-left:24px;font:400 14.5px/1.55 'EB Garamond',Georgia,serif;color:rgba(42,38,33,.7)">
        <div style="font:400 10.5px/1 'EB Garamond',Georgia,serif;letter-spacing:.2em;text-transform:uppercase;color:rgba(42,38,33,.6);margin-bottom:12px">How to read an entry</div>
        <p style="margin:0 0 9px"><em>Lasts</em> is the span at which the food is still worth eating, not merely still safe.</p>
        <p style="margin:0 0 9px"><em>Method</em> is the exact packing described. Change the packing and the figure no longer applies.</p>
        <p style="margin:0"><em>Notes</em> carries the failure mode: what goes wrong first, and what it smells or tastes like when it does.</p>
      </aside>
    </section>

    <section id="all-guides" style="padding:52px 0 0;scroll-margin-top:20px">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:32px;padding-bottom:12px;border-bottom:1.4px solid rgba(42,38,33,.75);flex-wrap:wrap">
        <h2 style="margin:0;font-family:'Bodoni Moda',Didot,serif;font-weight:500;font-size:34px;line-height:1;color:#2a2621">In the Cellar</h2>
        <a href="/guides/" style="font:400 11px/1 'EB Garamond',Georgia,serif;letter-spacing:.2em;text-transform:uppercase;color:rgba(42,38,33,.7)">Complete Index &rarr;</a>
      </div>
      <div class="sc-idx" style="display:grid;grid-template-columns:1fr 1fr;column-gap:64px;padding-top:18px">
        <div>
          {colA.map((a) => (
            <a href={`/${a.id}/`} class="sc-row"><span class="sc-row-t">{a.data.title}</span><span class="sc-row-dots"></span><span class="sc-row-tag">Guide</span></a>
          ))}
        </div>
        <div>
          {colB.map((a) => (
            <a href={`/${a.id}/`} class="sc-row"><span class="sc-row-t">{a.data.title}</span><span class="sc-row-dots"></span><span class="sc-row-tag">Guide</span></a>
          ))}
        </div>
      </div>
      <div style="margin-top:14px;padding-top:10px;border-top:.6px solid rgba(42,38,33,.28);font:400 13px/1.4 'EB Garamond',Georgia,serif;font-style:italic;color:rgba(42,38,33,.55)">{Math.min(30, total)} of {total} headings shown. The full index is at <a href="/guides/" style="color:#6f1d1d;font-style:normal">the complete index</a>.</div>
    </section>

    <div style="display:flex;align-items:center;gap:20px;padding:56px 0 46px">
      <div style="flex:1;border-bottom:.6px solid rgba(42,38,33,.35)"></div>
      <div style="font-family:'Bodoni Moda',Didot,serif;font-size:22px;line-height:1;color:#6f1d1d">&#10086;</div>
      <div style="flex:1;border-bottom:.6px solid rgba(42,38,33,.35)"></div>
    </div>

    <section style="max-width:62ch;margin:0 auto;text-align:center;padding-bottom:64px">
      <div style="font:400 10.5px/1 'EB Garamond',Georgia,serif;letter-spacing:.24em;text-transform:uppercase;color:rgba(42,38,33,.62);margin-bottom:20px">From the Quartermaster</div>
      <p style="margin:0 0 16px;font:italic 400 20px/1.66 'EB Garamond',Georgia,serif;color:#2a2621;text-wrap:pretty">A cellar is not built in a weekend and it is not a hedge against anything in particular. It is a habit: buy what you already eat, buy it twice, and write the date on the lid in pencil. The pencil matters. Ink runs when the jar sweats.</p>
      <p style="margin:0 0 22px;font:italic 400 20px/1.66 'EB Garamond',Georgia,serif;color:#2a2621;text-wrap:pretty">Everything else in this almanac is arithmetic performed on that habit.</p>
      <div style="font:400 11px/1 'EB Garamond',Georgia,serif;letter-spacing:.2em;text-transform:uppercase;color:rgba(42,38,33,.7)">The Quartermaster, StockCellar</div>
    </section>

  </div>

  <footer style="position:relative;border-top:1.6px solid rgba(42,38,33,.72);background:rgba(120,96,60,.045)">
    <div class="sc-foot-grid" style="max-width:1220px;margin:0 auto;padding:34px 56px 44px;display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:48px;align-items:start">
      <div>
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px">
          <span style="font-family:'Bodoni Moda',Didot,serif;font-weight:500;font-size:21px;letter-spacing:.01em;color:#2a2621">StockCellar</span>
        </div>
        <p style="margin:0;font:400 14px/1.6 'EB Garamond',Georgia,serif;color:rgba(42,38,33,.7);max-width:44ch;text-wrap:pretty">A reference almanac for household food storage. Figures are drawn from cooperative-extension and food-science publications and corrected in public when they are wrong.</p>
      </div>
      <div style="font:400 14px/1.9 'EB Garamond',Georgia,serif;color:rgba(42,38,33,.7)">
        <div style="font:400 10px/1 'EB Garamond',Georgia,serif;letter-spacing:.2em;text-transform:uppercase;color:rgba(42,38,33,.55);margin-bottom:10px">The Almanac</div>
        <div style="display:flex;flex-direction:column;gap:2px">
          <a href="/guides/" style="color:rgba(42,38,33,.78)">Complete Index</a>
          <a href="/about/" style="color:rgba(42,38,33,.78)">About</a>
          <a href="/editorial/" style="color:rgba(42,38,33,.78)">Sources &amp; Method</a>
          <a href="/contact/" style="color:rgba(42,38,33,.78)">Corrections</a>
        </div>
      </div>
      <div style="font:400 14px/1.9 'EB Garamond',Georgia,serif;color:rgba(42,38,33,.7)">
        <div style="font:400 10px/1 'EB Garamond',Georgia,serif;letter-spacing:.2em;text-transform:uppercase;color:rgba(42,38,33,.55);margin-bottom:10px">Colophon</div>
        <div>Set in Bodoni Moda &amp; EB&nbsp;Garamond.</div>
        <div style="display:flex;flex-direction:column;gap:2px;margin-top:6px">
          <a href="/disclosure/" style="color:rgba(42,38,33,.78)">Affiliate Disclosure</a>
          <a href="/privacy/" style="color:rgba(42,38,33,.78)">Privacy</a>
          <a href="/terms/" style="color:rgba(42,38,33,.78)">Terms</a>
        </div>
      </div>
    </div>
    <div style="max-width:1220px;margin:0 auto;padding:0 56px 30px">
      <div style="border-top:.6px solid rgba(42,38,33,.28);padding-top:12px;display:flex;justify-content:space-between;gap:24px;font:400 10.5px/1 'EB Garamond',Georgia,serif;letter-spacing:.16em;text-transform:uppercase;color:rgba(42,38,33,.5);flex-wrap:wrap">
        <span style="white-space:nowrap">StockCellar &#183; First Series</span>
        <span style="white-space:nowrap">&copy; 2026 StockCellar</span>
        <span style="white-space:nowrap">Revised 7 August 2026</span>
      </div>
    </div>
  </footer>
</div>

<style is:global>
  .sc a{text-decoration:none}
  .sc a:hover{text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:.5px}
  .sc ::selection{background:rgba(111,29,29,.16)}
  .sc .sc-th{text-align:left;padding:11px 16px 10px;border-bottom:.6px solid rgba(42,38,33,.6);font:400 10.5px/1 'EB Garamond',Georgia,serif;letter-spacing:.2em;text-transform:uppercase;color:rgba(42,38,33,.72)}
  .sc .sc-td{padding:15px 16px;border-bottom:.6px solid rgba(42,38,33,.16);vertical-align:baseline;font:400 16.5px/1.4 'EB Garamond',Georgia,serif;color:rgba(42,38,33,.85)}
  .sc tbody tr:last-child .sc-td{border-bottom:none}
  .sc tbody tr:hover{background:rgba(111,29,29,.055)}
  .sc .sc-item{font:500 18px/1.35 'EB Garamond',Georgia,serif;color:#2a2621}
  .sc .sc-num{font-family:'Bodoni Moda',Didot,serif;font-weight:500;font-size:18px;font-variant-numeric:lining-nums tabular-nums;white-space:nowrap;color:#6f1d1d}
  .sc .sc-note{color:rgba(42,38,33,.78);text-wrap:pretty}
  .sc .sc-row{display:flex;align-items:baseline;gap:8px;padding:8px 0;color:#2a2621}
  .sc .sc-row:hover{color:#6f1d1d;text-decoration:none}
  .sc .sc-row:hover .sc-row-t{text-decoration:underline;text-underline-offset:3px;text-decoration-thickness:.5px}
  .sc .sc-row-t{font:400 17.5px/1.3 'EB Garamond',Georgia,serif}
  .sc .sc-row-dots{flex:1;border-bottom:1.2px dotted rgba(42,38,33,.42);transform:translateY(-4px)}
  .sc .sc-row-tag{font:400 10.5px/1 'EB Garamond',Georgia,serif;letter-spacing:.16em;text-transform:uppercase;color:rgba(42,38,33,.6);white-space:nowrap}
  @media (max-width:900px){
    .sc .sc-wrap{padding:0 22px !important}
    .sc .sc-intro{grid-template-columns:1fr !important}
    .sc .sc-idx{grid-template-columns:1fr !important}
    .sc .sc-foot-grid{grid-template-columns:1fr !important;gap:24px !important;padding:28px 22px 36px !important}
  }
</style>
</Base>
